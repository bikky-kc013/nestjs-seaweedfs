{
  "name": "nestjs-seaweedfs",
  "version": "1.0.1",
  "description": "Production-grade NestJS SDK for SeaweedFS — Filer REST API + S3 Gateway API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts --testPathPattern=\\.spec\\.ts$",
    "test:e2e": "jest --config jest-e2e.config.ts",
    "test:cov": "jest --config jest.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "reflect-metadata": {
      "optional": false
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "axios": "^1.7.0",
    "change-case": "^5.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/aws-sdk": "^2.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "aws-sdk-client-mock": "^4.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "nestjs",
    "seaweedfs",
    "filer",
    "s3",
    "object-storage",
    "file-system",
    "module",
    "dii"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourscope/nestjs-seaweedfs.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
